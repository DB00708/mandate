# Copy to .env. With the defaults below everything runs offline (mock PayPal, rule-based parser)
# plus the self-hosted Langfuse at http://localhost:3000. Fill in the live section to use real services.

# ---------------------------------------------------------------- observability (Langfuse, self-hosted)
COMPOSE_PROFILES=observability   # starts langfuse-web/worker + its postgres, clickhouse, redis, minio
LANGFUSE_TRACING=1               # 0 = no traces, nothing imported
# Provisioned on first start; change them before exposing port 3000 anywhere but your laptop.
LANGFUSE_PUBLIC_KEY=pk-lf-mandate-local
LANGFUSE_SECRET_KEY=sk-lf-mandate-local
LANGFUSE_ADMIN_EMAIL=admin@mandate.local
LANGFUSE_ADMIN_PASSWORD=mandate-local-admin
# LANGFUSE_ENCRYPTION_KEY=       # 64 hex chars: openssl rand -hex 32
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_PORT=3000

# ---------------------------------------------------------------- LLM (the parser)
LLM_PROVIDER=rules               # rules | bedrock | nebius
# Amazon Bedrock (Amazon hackathon): an IAM user with bedrock:InvokeModel on the model below.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0     # or us.anthropic.claude-haiku-4-5-20251001-v1:0
# Nebius Token Factory (Nebius x NVIDIA hackathon): NVIDIA Nemotron models.
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_PARSER_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---------------------------------------------------------------- PayPal
PAYPAL_MODE=mock                 # mock | sandbox
# Sandbox REST app from developer.paypal.com (Apps & Credentials, Sandbox):
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_VAULT_ID=               # vaulted sandbox buyer: autonomous reorders without a tap
# PAYPAL_WEBHOOK_ID=             # needs a public URL; without it the reconciler confirms by polling
# PAYPAL_CURRENCY=USD            # if your sandbox merchant can't take INR
# PAYPAL_FX_PER_INR=0.012        # demo conversion; budgets and policy stay in rupees

ONBOARDING_TOKEN=sharma-onboarding-dev
COOLING_OFF_SECONDS=600
